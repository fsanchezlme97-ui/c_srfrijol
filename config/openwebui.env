# Open WebUI de c_srfrijol. Abierto a la red de casa (0.0.0.0:3000) y con cuenta: usuario y contraseña en
# config/webui-cuenta (no se sube a git). Las cuentas nuevas solo las crea el admin (registro cerrado).
# OJO: estas variables se leen en el PRIMER arranque y quedan guardadas en data/webui.db; después se cambian desde
# Ajustes › Administración de Open WebUI (o se borra data/ para empezar de cero).
DATA_DIR=/home/flsl/Proyectos/c_srfrijol/openwebui/data
WEBUI_AUTH=True
# registro cerrado y cuentas nuevas en espera hasta que el admin las apruebe (solo cuenta en una base de datos nueva)
ENABLE_SIGNUP=False
DEFAULT_USER_ROLE=pending
WEBUI_NAME=Open Web UI - C_SrFrijol
DEFAULT_LOCALE=es-ES
ENABLE_VERSION_UPDATE_CHECK=False
ENABLE_COMMUNITY_SHARING=False
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
# CORS_ALLOW_ORIGIN lo pone ./srfrijol al arrancar (localhost + IP de la red + nombre.local): solo la propia
# interfaz puede usar la API, no otras webs abiertas en el navegador.
ANONYMIZED_TELEMETRY=false
# Texto: Ollama (gemma4:e4b de Helpert, qwen3.5:9b) y llama-swap (Qwen3.6 35B-A3B por llama.cpp)
ENABLE_OLLAMA_API=True
OLLAMA_BASE_URL=http://127.0.0.1:11434
ENABLE_OPENAI_API=True
OPENAI_API_BASE_URLS=http://127.0.0.1:8090/v1
OPENAI_API_KEYS=local
# Voz: Kokoro (texto a voz) y whisper.cpp (voz a texto), por llama-swap
AUDIO_TTS_ENGINE=openai
AUDIO_TTS_OPENAI_API_BASE_URL=http://127.0.0.1:8090/v1
AUDIO_TTS_OPENAI_API_KEY=local
AUDIO_TTS_MODEL=kokoro
AUDIO_TTS_VOICE=ef_dora
AUDIO_STT_ENGINE=openai
AUDIO_STT_OPENAI_API_BASE_URL=http://127.0.0.1:8090/v1
AUDIO_STT_OPENAI_API_KEY=local
AUDIO_STT_MODEL=whisper
# Imagen: stable-diffusion.cpp por llama-swap (flux2-klein, sdxl, flux1-schnell)
ENABLE_IMAGE_GENERATION=True
IMAGE_GENERATION_ENGINE=openai
IMAGES_OPENAI_API_BASE_URL=http://127.0.0.1:8090/v1
IMAGES_OPENAI_API_KEY=local
IMAGE_GENERATION_MODEL=flux2-klein
IMAGE_SIZE=1024x1024
